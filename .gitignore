# 本地配置（含绑定 IP / 端口），不入库
.env

# 运行期数据与备份（含家庭真实财务信息）
data/*.db
data/*.db-wal
data/*.db-shm
data/backups/

# 编译产物
*.exe
scripts/bin/

# 运行日志与 pid
logs/
scripts/bin/*.pid
debug.log

# Python 字节码缓存
__pycache__/
*.pyc

# WorkBuddy 本地应用链接（含本机绝对路径）
*.genie

# 误建的 shell 展开目录（$(pwd) 字面量）
src/backend/$(pwd)/

# 本地诊断临时产物（浏览器 profile / 截图 / CDP 脚本 / clone 测试）
.chrome-*/
.shot-*.png
.cdp-check*.mjs
.clone-test/
.dom-*.txt
.dom-*.html
.chrome-console*.txt
.chrome-stderr.txt
.chrome-stdout.txt
.verify-*.mjs
.verify-root/
.verify-edit-root/
.chrome-edit-verify*/
.chrome-stock-*/

# Android 打包：工具链与下载包体积大不入库；源码与签名密钥保留，便于改地址后重新打包
.apkbuild/sdk/
.apkbuild/gradle-8.9/
.apkbuild/*.zip
.apkbuild/app/build/
.apkbuild/.gradle/
dist/*.apk

