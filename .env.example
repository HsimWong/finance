# 家庭财务管理系统 · 运行配置模板
# 复制为 .env 后修改：cp .env.example .env
# 优先级：命令行 -addr > 环境变量 > .env > 默认值

# 监听 IP：0.0.0.0 允许局域网设备（手机）访问；127.0.0.1 仅本机
BIND_HOST=0.0.0.0

# 监听端口
BIND_PORT=8081

# 可选：直接指定完整地址（如 192.168.1.10:8081），优先级高于上面两项
# HTTP_ADDR=127.0.0.1:8081

# 访问口令：设置后浏览器首次访问需输入，30 天免输
# 留空 = 关闭鉴权，仅限可信内网；公网暴露时必须设置
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(24))"
ACCESS_TOKEN=

# ---------- 固定入口网关（可选） ----------
# 配了 GATEWAY_URL 后，服务进程会每分钟读取隧道日志里的最新域名并上报给网关，
# 于是「固定域名/finance/」始终指向本机当前隧道。留空则完全不上报。
# GATEWAY_URL 填网关根地址，不要带 /api/register
GATEWAY_URL=
# 与网关的 GW_TOKEN 保持一致
GATEWAY_TOKEN=
# 挂载到网关下的路径前缀
GATEWAY_PREFIX=finance
# 在网关首页显示的名字
GATEWAY_NAME=家庭财务系统
# 上报间隔，默认 60s（最小 10s）
# GATEWAY_INTERVAL=60s
# 隧道日志路径，默认 <root>/logs/tunnel.log
# GATEWAY_TUNNEL_LOG=
